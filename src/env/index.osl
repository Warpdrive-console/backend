import "std:env"

enum key (
  ROTUR_APPID
  ROTUR_SECRET

  S3_ACCOUNT_ID
  S3_BUCKET_NAME
  S3_ACCESS_KEY_ID
  S3_SECRET_ACCESS_KEY
)

def load() result<unit, error> (
  env.load("../.env") catch (
  	log "Unable to load .env, make sure theres a .env file in the root of this project"
  	exit 1
  ) // load ./.env into ctx

  return result.ok()
)

// take only envKeys so that we can prevent misspells
def get(key keyEnum) string (
  string keyStr = keyEnum.toStr()
  if !env.has(keyStr) (
    // TODO: not sure if this should panic or not
    return ""
  )

  return env.get(keyStr)
)

export {load, get, key}
