import "std:requests"
import "std:crypto"

import "@utils/serve.osl"
import {validate} from "@utils/rotur.osl"

struct AuthBody (
  string validator = ""
)

def handleAuth(*serve.Context c) (
  auto body = c.body().parse<AuthBody>() catch (
    badRequest(c, "Request body must be {validator: string}")
    return
  )
  if body.validator == "" (
    badRequest(c, "Validator cannot be empty")
    return
  )

  auto validatorResp = validate(body.validator, validatorKey) catch (err) (
    badRequest(c, err.message)
    return
  )

  string sessionId = crypto.randomUUID()

  

  c.setCookie("sessionId", sessionId)
)
