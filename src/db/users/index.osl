import "std:fs"

import {getPath, _getDbPath} from "@db"
import {Session} from "@db/sessions"

struct User (
  string username = ""
  string app_token = ""
  Session[] sessions = []
)

def _getUserPath(string userid) result<string, error> (
  return _getDbPath("users", userid)
)

def exists(string userid) boolean (
  string path = _getUserPath(userid) catch (
    return false
  )
  return fs.exists(path)
)

def get(string userid) result<*User, error> (
  string userPath = _getUserPath(userid)!
  string userData = fs.readFile(userPath)!
  return userData.parse<*User>()
)

def set(string userid, *User userData) result<unit, error> (
  string userPath = _getUserPath(userid)!
  string userStr = userData.toStr()
  return fs.writeFile(userPath, userStr)
)

export {
  get,
  set,
  exists,
  User
}
