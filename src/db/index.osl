import "std:fs"

string? dbPath = null

def setPath(string path) result<unit, error> (
  dbPath = fs.cleanPath(path)
  void fs.mkdir(fs.joinPath(dbPath, "users"))
  void fs.mkdir(fs.joinPath(dbPath, "sessions"))

  return result.ok()
)

def getPath() string? (
  return dbPath
)

export {setPath, getPath}
export {
  get as userGet,
  exists as userExists
} from "./users"
